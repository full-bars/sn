[Unit]
Description=URNetwork Provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/urnetwork provide
Restart=on-failure
RestartSec=5
# 80 is minerExitAuthStopped: the persisted streak reached 30 refusals over
# at least 2 hours, so systemd must not restart it. Fix the credentials, then
# start the unit again.
RestartPreventExitStatus=80
Environment=HOME=/root
Environment=URNETWORK_RAMLOGS=0

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
