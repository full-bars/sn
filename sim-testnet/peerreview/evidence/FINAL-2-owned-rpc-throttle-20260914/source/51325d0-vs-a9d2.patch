+    def test_owned_rpc_gateway_has_no_request_or_connection_throttles(self):
+        """Reject every rendered rate/connection directive on either ingress."""
+        _, rendered = render_owned_rpc_gateway_fixture()
+        directives = [
+            line.split("#", 1)[0].strip()
+            for line in rendered.splitlines()
+        ]
+        throttles = [
+            line for line in directives
+            if re.match(r"limit_(?:req|conn)(?:\s|_)", line)
+        ]
+        self.assertEqual(
+            throttles, [], "owned rpc gateway still throttles approved callers"
+        )
+
+    def test_owned_rpc_gateway_keeps_both_restricted_routes(self):
+        """Removing quotas must preserve both exact listeners and access rules."""
+        values, rendered = render_owned_rpc_gateway_fixture()
+        servers = rendered.split("\n    server {")[1:]
+        self.assertEqual(len(servers), 2)
+        routes = (
+            (19944, "subtensor_archive_rpc", 19945),
+            (19946, "subtensor_lightnode_rpc", 19947),
+        )
+        for server, (port, upstream, backend) in zip(servers, routes):
+            self.assertEqual(
+                re.findall(r"\blisten\s+([^;]+);", server),
+                [f"{address}:{port}" for address in values["gateway_bind_addresses"]],
+            )
+            self.assertEqual(
+                re.findall(r"\ballow\s+([^;]+);", server),
+                values["gateway_allowed_cidrs"],
+            )
+            self.assertEqual(server.count("deny all;"), 2)
+            self.assertIn("limit_except GET POST {", server)
+            self.assertIn(f"proxy_pass http://{upstream};", server)
+            self.assertIn(f"server 127.0.0.1:{backend};", rendered)
+            self.assertIn("client_max_body_size 1m;", server)
+            self.assertIn("proxy_http_version 1.1;", server)
+            self.assertRegex(server, r"proxy_set_header\s+Upgrade\s+\$http_upgrade;")
+            self.assertRegex(
+                server, r"proxy_set_header\s+Connection\s+\$connection_upgrade;"
+            )
+            self.assertIn("proxy_buffering off;", server)
+            self.assertIn('return 200 "ok\\n";', server)
+
     def test_full_host_service_refreshes_are_change_driven(self):
         playbook = load_subtensor_playbook()
         tasks = tasks_by_name(playbook)
