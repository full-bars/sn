--- a/main/ansible/host_files/snow/subtensor/nginx.conf.j2
+++ b/main/ansible/host_files/snow/subtensor/nginx.conf.j2
@@ -6,8 +6,6 @@
 # The gateway is plaintext only on the restricted LAN and management tunnel.
 # Nginx source-allowlists those networks, listeners bind only exact interface
 # addresses, and the external firewall prevents public access to the host.
-# Approved callers share unpaced ingress without per-client request or
-# connection quotas; archive replay must not receive gateway-generated 429s.
 user nginx;
 worker_processes auto;
 
@@ -24,6 +22,13 @@
     server_tokens off;
     client_header_timeout 10s;
     client_body_timeout 10s;
+
+    limit_req_zone $binary_remote_addr zone=subtensor_rpc_rate:10m rate={{ gateway_requests_per_second }}r/s;
+    limit_req_zone $binary_remote_addr zone=subtensor_lightnode_rpc_rate:10m rate={{ gateway_requests_per_second }}r/s;
+    limit_conn_zone $binary_remote_addr zone=subtensor_rpc_connections:10m;
+    limit_conn_zone $binary_remote_addr zone=subtensor_lightnode_rpc_connections:10m;
+    limit_req_status 429;
+    limit_conn_status 429;
 
     # WebSocket upgrade passthrough (substrate ws + EVM ws share the RPC port)
     map $http_upgrade $connection_upgrade {
@@ -54,6 +59,8 @@
         deny all;
 
         location / {
+            limit_req zone=subtensor_rpc_rate burst={{ gateway_request_burst }} nodelay;
+            limit_conn subtensor_rpc_connections {{ gateway_connections_per_client }};
             limit_except GET POST {
                 deny all;
             }
@@ -94,6 +101,8 @@
         deny all;
 
         location / {
+            limit_req zone=subtensor_lightnode_rpc_rate burst={{ gateway_request_burst }} nodelay;
+            limit_conn subtensor_lightnode_rpc_connections {{ gateway_connections_per_client }};
             limit_except GET POST {
                 deny all;
             }
